# ──────────────────────────────────────────────
# LeadHaus AI — Variáveis de Ambiente
# Copie este arquivo para .env e preencha os valores
# Vars marcadas (OBRIG) fazem o app crashar se ausentes
# ──────────────────────────────────────────────

# Porta do servidor (padrão: 3000, ignorada no Vercel)
PORT=3000

# URL publica do app (usada pra webhooks, emails, OAuth callbacks)
SITE_URL=https://app.leadhouses.com.br

# ── Auth (OBRIG) ─────────────────────────────
# Secret pra assinar JWTs. Gere com: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=

# ── Supabase (OBRIG) ─────────────────────────
SUPABASE_URL=https://seu-projeto.supabase.co
# service_role bypassa RLS. OBRIGATORIA — app crasha sem ela.
# Supabase Dashboard > Settings > API > service_role (secret)
SUPABASE_SERVICE_ROLE=

# ── Anthropic / Claude (OBRIG) ───────────────
ANTHROPIC_API_KEY=sk-ant-...
# Override de modelo (opcional, default: claude-haiku-4-5-20251001)
# ANTHROPIC_MODEL=claude-haiku-4-5-20251001

# ── WhatsApp Cloud API (Meta) ────────────────
WHATSAPP_TOKEN=seu_token_permanente_aqui
WHATSAPP_PHONE_ID=seu_phone_number_id_aqui
WEBHOOK_VERIFY_TOKEN=leadhaus_verify_2024
# (RECOMENDADO) App Secret — valida X-Hub-Signature-256 nos webhooks Meta
# Meta Console > App > Configuracoes > Basico > "Chave secreta do app"
META_APP_SECRET=

# ── Evolution API (WhatsApp via Baileys) ─────
# URL e API key da instancia Evolution (Railway)
EVOLUTION_URL=https://sua-evolution.railway.app
EVOLUTION_API_KEY=sua_api_key
# (RECOMENDADO) Token de seguranca pra webhooks. Incluido como ?token= na URL
# do webhook. Instancias existentes precisam de POST /api/admin/migrate-webhooks
EVOLUTION_WEBHOOK_TOKEN=

# ── Stripe (pagamentos) ─────────────────────
STRIPE_SECRET_KEY=sk_live_...
STRIPE_WEBHOOK_SECRET=whsec_...
# Price IDs dos 3 planos (Stripe Dashboard > Products > cada produto > API ID)
STRIPE_START_PRICE_ID=price_...
STRIPE_PRO_PRICE_ID=price_...
STRIPE_ELITE_PRICE_ID=price_...

# ── Google OAuth (login + Calendar) ──────────
GOOGLE_CLIENT_ID=...apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=GOCSPX-...

# ── Google Sheets (opcional — backup de leads)
GOOGLE_SHEET_ID=seu_sheet_id_aqui
GOOGLE_SHEET_ABA=Leads
GOOGLE_CREDENTIALS_JSON={"type":"service_account",...}

# ── Push Notifications (VAPID) ───────────────
# Gerar par: npx web-push generate-vapid-keys
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
# Formato: mailto:seu@email.com
VAPID_SUBJECT=mailto:leadhouse.gestaoimobiliaria@gmail.com

# ── Emails (Resend) ─────────────────────────
RESEND_API_KEY=re_...

# ── Monitoramento ────────────────────────────
# DSN do Sentry pra error tracking (opcional)
SENTRY_DSN=
# Secret pra autenticar cron jobs do Vercel
CRON_SECRET=
# Secret pra endpoint /api/admin/audit-summary
ADMIN_AUDIT_SECRET=
