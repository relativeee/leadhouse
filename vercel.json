{
  "version": 2,
  "builds": [
    {
      "src": "public/**",
      "use": "@vercel/static"
    },
    {
      "src": "server.js",
      "use": "@vercel/node",
      "config": {
        "includeFiles": ["public/**", "prompts/**", "services/**", "utils/**"],
        "maxDuration": 60
      }
    }
  ],
  "routes": [
    { "src": "/api/(.*)", "dest": "/server.js" },
    { "src": "/webhook(.*)", "dest": "/server.js" },
    { "src": "/health", "dest": "/server.js" },
    { "src": "/login", "dest": "/public/login.html" },
    { "src": "/(.*\\.css)", "dest": "/public/$1" },
    { "src": "/(.*\\.svg)", "dest": "/public/$1" },
    { "src": "/(.*\\.js)", "dest": "/public/$1", "headers": { "Content-Type": "application/javascript" } },
    { "src": "/(.*\\.html)", "dest": "/public/$1" },
    { "src": "/manifest\\.webmanifest", "dest": "/public/manifest.webmanifest", "headers": { "Content-Type": "application/manifest+json" } },
    { "src": "/(.*\\.png)", "dest": "/public/$1" },
    { "src": "/(.*\\.ico)", "dest": "/public/$1" },
    { "src": "/", "dest": "/public/index.html" },
    { "src": "/(.*)", "dest": "/server.js" }
  ],
  "crons": [
    { "path": "/api/cron/trial-expiring", "schedule": "0 13 * * *" }
  ]
}
